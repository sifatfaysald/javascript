# ======================
# 👨‍💻 JavaScript / Node.js Git Ignore
# ======================

# --- Node modules ---
node_modules/

# --- Logs & Debug Files ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime files ---
dist/
build/
.tmp/
temp/
cache/
coverage/

# --- OS-specific files ---
.DS_Store      # macOS
Thumbs.db      # Windows

# --- IDEs / Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Environment variables ---
.env
.env.local
.env.*.local

# --- Dependency lock files (optional if using only one) ---
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# --- Test coverage ---
coverage/
.nyc_output/

# --- Binaries ---
*.exe
*.out
*.app

# --- Misc ---
*.log
*.tgz
*.zip
*.tar

# --- Optional: Ignore everything except source ---
# !src/
# !public/
